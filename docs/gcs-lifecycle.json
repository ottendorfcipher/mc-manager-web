{
  "lifecycle": {
    "rule": [
      {
        "action": { "type": "Delete" },
        "condition": {
          "age": 30,
          "matchesPrefix": ["backups/regular/"]
        }
      },
      {
        "action": { "type": "Delete" },
        "condition": {
          "age": 365,
          "matchesPrefix": ["backups/extended/"]
        }
      }
    ]
  }
}
