# ── Line endings ──────────────────────────────────────────────────────────────
# Normalize all text files to LF in the repo; check out as native on each OS.
* text=auto eol=lf

# ── Explicit text files ──────────────────────────────────────────────────────
*.rs        text diff=rust
*.toml      text
*.lock      text -diff
*.sql       text

*.ts        text
*.tsx       text
*.js        text
*.jsx       text
*.json      text
*.css       text
*.html      text

*.md        text diff=markdown
*.yml       text
*.yaml      text
*.conf      text

*.sh        text eol=lf
*.py        text eol=lf diff=python
*.mcfunction text eol=lf
*.mcmeta    text

# ── Binary files (no merge, no diff) ─────────────────────────────────────────
*.png       binary
*.gif       binary
*.jpg       binary
*.jpeg      binary
*.ico       binary
*.svg       text
*.zip       binary
*.tar.gz    binary
*.ogg       binary
*.mp3       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary

# ── Lock files ────────────────────────────────────────────────────────────────
# Show in diffs but treat as generated (no manual merge).
Cargo.lock            text -diff linguist-generated
package-lock.json     text -diff linguist-generated

# ── GitHub linguist overrides ─────────────────────────────────────────────────
# Exclude generated / vendored paths from language stats.
frontend/dist/**      linguist-generated
backend/target/**     linguist-generated
backend/bindings/**   linguist-generated
docs/**               linguist-documentation
