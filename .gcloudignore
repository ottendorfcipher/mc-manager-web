# Cloud Build source upload exclusions.
# Without this, gcloud builds submit would upload ~1.8 GB of local artifacts.
# The Dockerfile rebuilds everything from scratch inside Cloud Build.

.git/
.env
.env.*

# Rust compilation cache (~1.5 GB locally)
backend/target/

# Node modules (~320 MB locally)
frontend/node_modules/
frontend/dist/

# Local dev artefacts
frontend/certs/
frontend/playwright-report/
frontend/test-results/
*.db
*.db-shm
*.db-wal

# macOS
.DS_Store
