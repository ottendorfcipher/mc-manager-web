# /etc/mc-watchdog.env  —  environment for the mc-watchdog systemd service.
#
# Copy this file to /etc/mc-watchdog.env on mc-server-1 and fill in the
# values before enabling the service.
#
# WATCHDOG_TOKEN must match the WATCHDOG_TOKEN secret in the backend .env /
# Cloud Run environment.  Generate with:  openssl rand -hex 32

BACKEND_URL=https://example.com
WATCHDOG_TOKEN=REPLACE_WITH_SECURE_TOKEN

# Paths — only change if your Minecraft install differs from the defaults.
MC_LOG_PATH=/opt/minecraft/server/logs/latest.log
MC_FIFO_PATH=/opt/minecraft/console.fifo
