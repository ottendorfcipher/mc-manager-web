[Unit]
Description=PaperMC Minecraft Server
After=network.target

[Service]
User=minecraft
WorkingDirectory=/opt/minecraft/server

# Wrap the JVM in a shell so the FIFO console pipe has a permanent reader.
#
# Problem with naive ExecStart=/usr/bin/java ... --nogui:
#   console.fifo has no reader → every write from the web backend blocks
#   indefinitely → all fifo_command calls (give items, whitelist, ban, etc.)
#   hit the Tokio SSH timeout and return 502.
#
# Fix:
#   exec 3<>$FIFO  — opens the named pipe for both read AND write (O_RDWR);
#                    this prevents external writers from blocking (they need a
#                    reader), and prevents cat from ever seeing EOF (they need
#                    a writer to stay alive).
#   cat <&3        — reads directly from fd 3, which is the same open file
#                    description as the FIFO; cat does a plain blocking read()
#                    on each call, so data written to the FIFO is forwarded to
#                    Java's stdin immediately, one write() per read().
#
# Why not tail -f $FIFO:
#   tail opens the FIFO on its OWN fd and registers an inotify watch for
#   IN_MODIFY.  When the parent bash also holds an O_RDWR fd (exec 3<>$FIFO),
#   FIFO writes are consumed by whichever fd's read() call is scheduled first
#   — often the bash fd, not tail's fd.  Data disappears into bash's read
#   buffer without ever reaching Java.  cat <&3 eliminates the race because
#   there is only one fd: fd 3, shared by bash and cat.
#
# Result: external writes from the backend complete in ~1 ms.
ExecStart=/bin/bash -c \
  'FIFO=/opt/minecraft/console.fifo; \
   mkfifo $FIFO 2>/dev/null || true; \
   exec 3<>$FIFO; \
   cat <&3 | java -Xmx6G -Xms2G \
     -XX:+UseG1GC -XX:+ParallelRefProcEnabled -XX:MaxGCPauseMillis=200 \
     -XX:+UnlockExperimentalVMOptions -XX:+DisableExplicitGC -XX:+AlwaysPreTouch \
     -XX:G1HeapWastePercent=5 -XX:G1MixedGCCountTarget=4 \
     -XX:G1MixedGCLiveThresholdPercent=90 -XX:G1RSetUpdatingPauseTimePercent=5 \
     -XX:SurvivorRatio=32 -XX:+PerfDisableSharedMem -XX:MaxTenuringThreshold=1 \
     -Dusing.aikars.flags=https://mcflags.emc.gs -Daikars.new.flags=true \
     -jar server.jar --nogui'

KillSignal=SIGINT
KillMode=mixed
Restart=on-failure
RestartSec=10
StandardInput=null
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
