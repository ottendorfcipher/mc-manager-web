[Unit]
Description=redstoneCipher Web Server
After=network.target tailscaled.service

[Service]
User=redstonecipher
Group=redstonecipher
WorkingDirectory=/opt/redstonecipher
EnvironmentFile=/opt/redstonecipher/.env
ExecStart=/opt/redstonecipher/redstonecipher-server
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# ── Hardening ─────────────────────────────────────────────────────────────────

# Prevent the process from gaining new privileges via setuid/setgid executables.
NoNewPrivileges=yes

# Give the service an isolated /tmp — it cannot snoop on other services' temp files.
PrivateTmp=yes

# The service has no reason to read /home or /root.
ProtectHome=yes

# Mount the filesystem read-only system-wide, then punch specific write holes.
# The service only needs to write to the DB directory and the served frontend assets.
ProtectSystem=strict
ReadWritePaths=/opt/redstonecipher/data /opt/redstonecipher/www

# Drop all Linux capabilities. The service binds to port 8080 (unprivileged)
# and performs all privileged operations (SSH to mc-server-1) as the
# 'redstonecipher' user with its dedicated key — no capabilities needed.
CapabilityBoundingSet=
AmbientCapabilities=

# Restrict to the system-service syscall group (covers everything a well-behaved
# Tokio/Axum server needs: networking, file I/O, threading, timers, signals).
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# Only allow the host's native syscall ABI (blocks x32/compat-ABI evasion).
SystemCallArchitectures=native

# ── Breach containment (added) ────────────────────────────────────────────────
# These limit what a compromised dependency could do at runtime even if it
# achieved code execution inside the process. None affect the app's behavior.

# Address families the service actually uses:
#   INET/INET6 — the HTTP server + all outbound HTTPS (OAuth, Discord, MC API)
#   UNIX       — local IPC / logging sockets
#   NETLINK    — required by glibc getaddrinfo for DNS + by the ssh subprocess
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

# Kernel/host surfaces the service never touches — deny them.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes

# Misc privilege/behavior restrictions.
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
# Rust does not JIT, so write+execute memory is never needed — blocking it stops
# a whole class of injected-shellcode techniques.
MemoryDenyWriteExecute=yes
# New files/dirs are owner-only by default.
UMask=0077

[Install]
WantedBy=multi-user.target
