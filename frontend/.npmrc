# Frontend npm hardening — supply-chain controls for local + CI installs.
#
# ignore-scripts: the single most important npm-malware mitigation. Package
# install lifecycle scripts (preinstall/install/postinstall) are how worms like
# Shai-Hulud and the Sept-2025 chalk/debug compromise execute on dev/CI machines.
# Disabling them neutralizes that vector. If a dependency ever genuinely needs an
# install script to build, rebuild it explicitly and narrowly:  npm rebuild <pkg>
ignore-scripts=true

# New installs pin the exact version (no caret drift into an unreviewed release).
save-exact=true

# We run `npm audit` explicitly in CI; don't run it implicitly on install.
audit=false

# Don't fetch funding metadata on install.
fund=false

# Only ever resolve packages from the official registry (anti dependency-confusion).
registry=https://registry.npmjs.org/
