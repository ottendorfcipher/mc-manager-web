{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "analyze": "npm run typecheck && eslint . && jscpd src && type-coverage -p tsconfig.app.json --at-least 95 --strict && knip",
    "test:e2e": "playwright test",
    "preview": "vite preview"
  },
