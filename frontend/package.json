    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.46",
    "@types/leaflet": "^1.9.22",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.61.0",
    "minecraft-data": "^3.117.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
