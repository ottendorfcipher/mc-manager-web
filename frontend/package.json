    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-sonarjs": "^3.0.5",
    "globals": "^17.4.0",
    "jscpd": "^4.0.5",
    "knip": "^5.70.0",
    "postcss": "^8.5.9",
    "tailwindcss": "^3.4.19",
