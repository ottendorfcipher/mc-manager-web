# Copy this file to .env and fill in the values.
# The backend reads from .env at startup; the frontend reads from vite via proxy.

# ── Required ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///Users/nicholasweiner/Desktop/mc-manager-web/mc-manager.db

# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_random_64_char_hex_string

# From GCP Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web)
# Authorized redirect URIs (add BOTH — Google won't accept a URI that isn't listed):
#   http://localhost:5173/auth/callback   (local dev — Vite proxies /auth/* to the backend)
#   https://redstonecipher.com/auth/callback   (production)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Optional overrides ────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8787
# Use the localhost URI for dev; swap to the production URI when deploying.
REDIRECT_URI=http://localhost:5173/auth/callback

# GCP settings (default values shown)
GCP_PROJECT=minecraft-493201
GCP_ZONE=us-central1-a
GCP_INSTANCE=mc-server-spot
TAILSCALE_IP=100.80.114.91

# Cloud backup storage — set this to upload backups to GCS (required for cloud tier)
# GCS_BACKUP_BUCKET=your-bucket-name
GCS_BACKUP_BUCKET=mc-server-backups-491

# Paths (auto-detected from $HOME if not set)
# BACKUP_DIR=/Users/nicholasweiner/Desktop/minecraft server/backups
# GCLOUD_BIN=/Users/nicholasweiner/google-cloud-sdk/bin/gcloud

# ── Onboarding / invite (all optional) ────────────────────────────────────────
# Resend API key for sending HTML invite emails (https://resend.com)
# RESEND_API_KEY=re_...
#
# Tailscale API key + tailnet for generating user invite links
# Get from https://login.tailscale.com/admin/settings/keys → API keys
# TAILSCALE_API_KEY=tskey-api-...
# TAILSCALE_TAILNET=your-tailnet-name-or-email
#
# Public base URL of this site — used in email invite links
# SITE_URL=https://redstonecipher.com
