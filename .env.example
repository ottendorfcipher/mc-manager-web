# Copy this file to .env and fill in the values.
# The backend reads .env at startup. The frontend talks to it through the Vite
# dev proxy in development, or nginx in production.

# ── Required ──────────────────────────────────────────────────────────────────

# SQLite database path. The parent directory must exist and be writable.
DATABASE_URL=sqlite://data/mc-manager.db

# Session signing key. Generate one with: openssl rand -hex 32
JWT_SECRET=replace_with_a_random_64_char_hex_string

# Google OAuth is the only way to sign in. Create credentials in the Google
# Cloud Console under APIs and Services, Credentials, OAuth 2.0 Client ID (Web).
# Register every redirect URI you will use:
#   http://localhost:5173/auth/callback    (local dev)
#   https://your-domain.com/auth/callback  (production)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# The account that signs in with this email becomes the global admin on first
# login. Use your own Google address.
BOOTSTRAP_ADMIN_EMAIL=you@example.com

# ── Common ────────────────────────────────────────────────────────────────────

HOST=127.0.0.1
PORT=8787

# Must exactly match one of the redirect URIs registered with Google above.
REDIRECT_URI=http://localhost:5173/auth/callback

# Public base URL of this site. Used in email links and resource pack URLs.
SITE_URL=http://localhost:8787

# Keep true in production. Set false only for a local plain-HTTP run, otherwise
# the browser drops the Secure session cookie and login silently fails.
COOKIE_SECURE=true

# First-run web setup: when Google is not configured, the app serves a /setup
# wizard before the login screen; it saves config to the database and restarts
# to apply it. On an internet-exposed host set SETUP_TOKEN to a random value
# (start-here.sh does this) so only someone with the token can finish setup.
# SETUP_TOKEN=

# Browser origins allowed to call the API, comma separated. Defaults to SITE_URL.
# The local dev server is always allowed.
# CORS_ORIGINS=https://your-domain.com

# Sender for outbound email. Only used when RESEND_API_KEY is set below.
# EMAIL_FROM=redstoneCipher <onboarding@your-domain.com>

# ── Cloudflare Access login (optional) ────────────────────────────────────────
# Adds a "Sign in with Cloudflare" button next to Google. Create a SaaS OIDC
# application in Cloudflare Zero Trust (Access, Applications, Add a SaaS app,
# OIDC). Set the redirect URL there to https://your-domain.com/auth/callback/cloudflare
# Set all three values to enable the button. Team domain is the short name or the
# full myteam.cloudflareaccess.com.
# CLOUDFLARE_TEAM_DOMAIN=myteam
# CLOUDFLARE_CLIENT_ID=your_cloudflare_client_id
# CLOUDFLARE_CLIENT_SECRET=your_cloudflare_client_secret
# Override the callback URL if it differs from {SITE_URL}/auth/callback/cloudflare
# CLOUDFLARE_REDIRECT_URI=

# ── Minecraft server connection ───────────────────────────────────────────────
# The backend controls the Minecraft server over SSH. For the bundled local
# server (docker compose --profile local) this is the mc service hostname.
TAILSCALE_IP=127.0.0.1

# For a REMOTE Minecraft server (docker-compose.remote.yml), set MC_HOST to its
# host or IP; the backend connects as root@MC_HOST over SSH. A Tailscale IP keeps
# the game port private; a plain IP works too. start-here.sh sets this up for you.
# MC_HOST=100.x.y.z

# Shared token for the watchdog calling /internal/player-joined. When unset,
# that endpoint rejects every request. Generate one: openssl rand -hex 32
# WATCHDOG_TOKEN=

# ── Optional integrations ─────────────────────────────────────────────────────
# Resend API key (https://resend.com) for invite and alert emails. When unset,
# email is skipped and invites are still created in the database.
# RESEND_API_KEY=re_...
#
# Tailscale API key and tailnet for generating in-app device invite links.
# https://login.tailscale.com/admin/settings/keys
# TAILSCALE_API_KEY=tskey-api-...
# TAILSCALE_TAILNET=your-tailnet-name-or-email

# Discord and Modrinth credentials are not set here. They live encrypted in the
# database and are managed from Admin, Integrations.
