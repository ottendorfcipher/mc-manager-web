# Copy this file to .env and fill in the values.
# The backend reads from .env at startup; the frontend reads from vite via proxy.

# ── Required ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///opt/redstonecipher/data/mc-manager.db

# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_random_64_char_hex_string

# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web).
# (Google OAuth only — unrelated to the decommissioned GCP compute below.)
# Authorized redirect URIs (add BOTH — Google won't accept a URI that isn't listed):
#   http://localhost:5173/auth/callback   (local dev — Vite proxies /auth/* to the backend)
#   https://example.com/auth/callback   (production)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Optional overrides ────────────────────────────────────────────────────────
HOST=127.0.0.1
# Production binds 8080 (the systemd unit sets PORT; nginx proxies to it).
PORT=8080
# Use the localhost URI for dev; swap to the production URI when deploying.
REDIRECT_URI=http://localhost:5173/auth/callback

# Tailscale IP of this host (used for the in-VPN admission checks).
TAILSCALE_IP=100.64.0.3

# Shared bearer token for the mc-server-1 watchdog → /internal/player-joined.
# When unset, that endpoint rejects every request. Generate: openssl rand -hex 32
# WATCHDOG_TOKEN=

# ── Onboarding / invite + notifications (all optional) ────────────────────────
# Resend API key (https://resend.com) — sends HTML invite emails AND the
# "new player waiting for approval" admin alert. When unset, email is skipped.
# RESEND_API_KEY=re_...
#
# Tailscale API key + tailnet for generating user invite links
# Get from https://login.tailscale.com/admin/settings/keys → API keys
# TAILSCALE_API_KEY=tskey-api-...
# TAILSCALE_TAILNET=your-tailnet-name-or-email
#
# Public base URL of this site — used in email invite links + admin alerts
# SITE_URL=https://example.com

# ── Legacy: GCP compute (DECOMMISSIONED) ──────────────────────────────────────
# The Minecraft server now runs on a Hetzner VPS reached over Tailscale; the GCP
# instance was retired (May 2026). These are read only by the deprecated
# `gcloud` module and can be left unset — they all have inert defaults.
# GCP_PROJECT=
# GCP_ZONE=
# GCP_INSTANCE=
# GCS_BACKUP_BUCKET=
# GCLOUD_BIN=

# Discord and Modrinth credentials are NOT set here — they live AES-256-GCM
# encrypted in the app_settings table, managed via Admin → Integrations.
